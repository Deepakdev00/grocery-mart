DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_CREATION_SECRET="replace-with-a-separate-long-random-secret"
CLIENT_ORIGIN="http://localhost:3000"
# Comma-separated trusted proxy CIDRs; leave empty when the API is reached directly.
TRUSTED_PROXY_CIDRS=""
PORT=5000
NODE_ENV=development
