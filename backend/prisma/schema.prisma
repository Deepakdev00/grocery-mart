// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  email               String               @unique
  password            String
  role                String               @default("customer") // "customer" | "staff" | "supplier" | "retailer"
  status              String               @default("active") // "active" | "inactive" | "suspended"
  phone               String?
  address             Address?
  profile             UserProfile?
  carts               Cart[]
  payments            Payment[]
  supportTickets      SupportTicket[]
  loginLogs           LoginLog[]
  activeSessions      ActiveSession[]
  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]
  otpLogs             OtpLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([email])
}

model Address {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String?
  city      String?
  state     String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  name      String
  weight    String
  price     Float
  img       String?
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([cartId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           PaymentItem[]
  itemTotal       Float
  deliveryFee     Float         @default(0)
  handlingFee     Float         @default(2)
  grandTotal      Float
  paymentMethod   String // "upi" | "card" | "cod"
  status          String        @default("pending") // "pending" | "completed" | "failed"
  deliveryAddress String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model PaymentItem {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  productId String
  name      String
  weight    String?
  price     Float
  qty       Int

  @@index([paymentId])
}

model Admin {
  id        String         @id @default(cuid())
  username  String         @unique
  email     String         @unique
  password  String
  role      String         @default("admin") // "admin" | "super_admin"
  sessions  AdminSession[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([email])
}

model AdminSession {
  id         String   @id @default(cuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  loginAt    DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  isActive   Boolean  @default(true)

  @@index([adminId])
  @@index([token])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Float
  category    String // "vegetables" | "fruits" | "dairy"
  imageUrl    String
  description String?
  inStock     Boolean  @default(true)
  createdBy   String // admin id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber  String?
  profileImage String? // URL
  theme        String   @default("light") // "light" | "dark"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupportTicket {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      String         @default("open") // "open" | "in_progress" | "resolved" | "closed"
  priority    String         @default("medium") // "low" | "medium" | "high"
  category    String // "complaint" | "bug" | "suggestion"
  replies     SupportReply[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

model SupportReply {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String // Could be user or admin/support staff
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model SupportStaff {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("support") // "support" | "support_manager"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ─── Auth Module Models ─────────────────────────────────────────────────────

model Role {
  id          String              @id @default(cuid())
  name        String              @unique // "admin" | "staff" | "supplier" | "retailer" | "customer"
  description String?
  permissions RolePermissionMap[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Permission {
  id          String              @id @default(cuid())
  name        String              @unique // e.g., "manage_products", "view_orders", "manage_users"
  description String?
  module      String // e.g., "products", "orders", "users", "support"
  roles       RolePermissionMap[]
  createdAt   DateTime            @default(now())
}

model RolePermissionMap {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  otp       String? // 6-digit OTP alternative
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model ActiveSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  refreshToken String?  @unique
  ipAddress    String?
  userAgent    String?
  deviceInfo   String?
  loginAt      DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  isActive     Boolean  @default(true)

  @@index([userId])
  @@index([token])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  action    String // "login_success" | "login_failed" | "logout" | "password_reset" | "account_locked"
  ipAddress String?
  userAgent String?
  location  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // "profile_update" | "password_change" | "role_change" | "status_change" | etc
  details   String? // JSON string with additional info
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model OtpLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp       String
  purpose   String // "two_factor_auth" | "password_reset" | "email_verification"
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([otp])
}
